### ===============================
### TEST 17 – Strategy Syntax Error
### ===============================

POST http://localhost:8080/api/game/setup/full/1
Content-Type: application/json

[
  {
    "type": "FIGHTER",
    "defenseFactor": 1,
    "strategy": "move up up up;"
  }
]

###

### ===============================
### TEST 18 – Division by Zero
### ===============================

POST http://localhost:8080/api/game/setup/full/1
Content-Type: application/json

[
  {
    "type": "FIGHTER",
    "defenseFactor": 1,
    "strategy": "x = 1 / 0; move up; done;"
  }
]

###

### ===============================
### TEST 19 – Infinite Loop Protection
### ===============================

POST http://localhost:8080/api/game/setup/full/1
Content-Type: application/json

[
  {
    "type": "FIGHTER",
    "defenseFactor": 1,
    "strategy": "while (1) { move up; }"
  }
]

###

