
### RESET
POST http://localhost:8080/api/game/reset

###

### CONFIG
POST http://localhost:8080/api/game/config
Content-Type: application/json

{
  "spawnCost": 100,
  "hexPurchaseCost": 1000,
  "initBudget": 10000,
  "initHp": 100,
  "turnBudget": 90,
  "maxBudget": 23456,
  "interestPct": 5,
  "maxTurns": 20,
  "maxSpawns": 5
}

###

### MODE = DUEL
POST http://localhost:8080/api/game/mode
Content-Type: application/json

{
  "mode": "DUEL"
}

###

### CHARACTER P1 = HUMAN
POST http://localhost:8080/api/game/character
Content-Type: application/json

{
  "playerId": 1,
  "character": "HUMAN"
}

###

### CHARACTER P2 = DEMON
POST http://localhost:8080/api/game/character
Content-Type: application/json

{
  "playerId": 2,
  "character": "DEMON"
}

###

### SETUP P1 (SHARED STRATEGY SET, NAME LEFT BLANK TO ALLOW DEFAULT FALLBACK)
POST http://localhost:8080/api/game/setup/full/1
Content-Type: application/json

[
  {
    "type": "FIGHTER",
    "name": "",
    "defenseFactor": 1,
    "strategy": "move up; done;"
  }
]

###

### SETUP P2 (MIRRORED SHARED SET WITH DEFAULT DEMON NAME)
POST http://localhost:8080/api/game/setup/full/2
Content-Type: application/json

[
  {
    "type": "FIGHTER",
    "name": "MUZAN",
    "defenseFactor": 1,
    "strategy": "move up; done;"
  }
]

###

### START GAME
POST http://localhost:8080/api/game/start

###

### CHECK PHASE -> FREE_SPAWN
GET http://localhost:8080/api/game/phase

###

### CHECK STATE -> NAMES SHOULD RESOLVE CORRECTLY
GET http://localhost:8080/api/game/state

###

### P1 FREE SPAWN
POST http://localhost:8080/api/game/spawn
Content-Type: application/json

{
  "type": "FIGHTER",
  "row": 0,
  "col": 0
}

###

### CHECK CURRENT PLAYER -> 2
GET http://localhost:8080/api/game/current-player

###

### P2 FREE SPAWN
POST http://localhost:8080/api/game/spawn
Content-Type: application/json

{
  "type": "FIGHTER",
  "row": 7,
  "col": 7
}

###

### CHECK PHASE -> PLAYER_ACTION / BUY_HEX STEP
GET http://localhost:8080/api/game/phase

###

### BUY HEX ONCE -> SHOULD PASS
POST http://localhost:8080/api/game/buy-hex
Content-Type: application/json

{
  "row": 2,
  "col": 1
}

###

### BUY HEX AGAIN IN SAME TURN -> SHOULD FAIL
POST http://localhost:8080/api/game/buy-hex
Content-Type: application/json

{
  "row": 2,
  "col": 2
}

###

### NORMAL SPAWN AFTER BUY HEX -> SHOULD PASS
POST http://localhost:8080/api/game/spawn
Content-Type: application/json

{
  "type": "FIGHTER",
  "row": 0,
  "col": 1
}

###

### BUY HEX AFTER SPAWN IN SAME TURN -> SHOULD FAIL
POST http://localhost:8080/api/game/buy-hex
Content-Type: application/json

{
  "row": 3,
  "col": 1
}

###

### SPAWN AGAIN IN SAME TURN -> SHOULD FAIL
POST http://localhost:8080/api/game/spawn
Content-Type: application/json

{
  "type": "FIGHTER",
  "row": 0,
  "col": 2
}

###

### END TURN
POST http://localhost:8080/api/game/end-turn

###

### CHECK PHASE -> PLAYER_ACTION / BUY_HEX STEP OF NEXT TURN
GET http://localhost:8080/api/game/phase

###

### CHECK STATE
GET http://localhost:8080/api/game/state

###
